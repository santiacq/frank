# Frank configuration. Copy to .env and fill in your values.
# Every key below has a sensible default shown here.

# Which provider to use: "openrouter" or "llama"
FRANK_PROVIDER=openrouter

# --- OpenRouter (remote) ---
OPENROUTER_API_KEY=sk-or-...
# OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- llama.cpp (local) ---
# Point at a running `llama-server`. Start one with, e.g.:
#   llama-server -m <model.gguf> --port 8080
# The openai library expects a "/v1" base path in front of /chat/completions.
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
# The model name `llama-server` was started with (`/v1/models`).
LLAMA_CPP_MODEL=your-local-model-name
